{
  "name": "rsocket-js",
  "version": "0.0.1-alpha",
  "description": "The RSocket client implementation via websocket to browser compatibility based on Uint8Array",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts",
    "start": "tsx src/start.ts",
    "start:watch": "tsx watch src/start.ts",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch"
  },
  "author": "FakeIvchenko, CKATEPTb",
  "license": "LGPL-3.0-only",
  "devDependencies": {
    "@ckateptb/reactive-core-js": "github:CKATEPTb/reactor-core-js#production",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
